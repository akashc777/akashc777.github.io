---
layout: null
permalink: /search.json
sitemap: false
---
{%- comment -%} The search index, fetched by /search only when someone searches. {%- endcomment -%}
[{% for post in site.posts %}{"t":{{ post.title | jsonify }},"u":{{ post.url | relative_url | jsonify }},"d":{{ post.date | date: '%-d %b %Y' | jsonify }},"i":{{ post.date | date_to_xmlschema | jsonify }},"g":{{ post.tags | join: ' ' | jsonify }},"s":{{ post.description | strip_html | strip_newlines | jsonify }},"b":{{ post.content | strip_html | strip_newlines | jsonify }}}{% unless forloop.last %},
{% endunless %}{% endfor %}]
